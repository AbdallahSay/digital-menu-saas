# Examples only. ASP.NET reads these names from environment variables, not this file.
# Use a dedicated local development database; review production TLS separately.
ConnectionStrings__MenuDatabase=Server=<sql-server>;Database=<dedicated-database>;User ID=<least-privilege-user>;Password=<secret-manager-value>;Encrypt=true
ASPNETCORE_ENVIRONMENT=Development
# Used only by the explicit Development --bootstrap-admin=true command.
Bootstrap__Email=<local-admin-email>
Bootstrap__Password=<secret-manager-value>
