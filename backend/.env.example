# Examples only. ASP.NET reads these names from environment variables, not this file.
# Use a dedicated local development database; review production TLS separately.
ConnectionStrings__MenuDatabase=Server=<sql-server>;Database=<dedicated-database>;User ID=<least-privilege-user>;Password=<secret-manager-value>;Encrypt=true
ASPNETCORE_ENVIRONMENT=Development
# Used only by the explicit Development --bootstrap-admin=true command.
Bootstrap__Email=<local-admin-email>
Bootstrap__Password=<secret-manager-value>
# Optional test-only LocalDB file directory (must be an absolute local path).
# Leave unset in Docker/CI; never use an existing production database.
F02_SQL_DATA_DIRECTORY=<absolute-local-test-directory>
# F04 has no configurable email sender or secret-bearing HTTP delivery route.
# Local IPC delivery requires BOTH Development and explicit activation. Ignored in Production/Staging.
DevelopmentOnboarding__Enabled=false
DevelopmentOnboarding__PipeName=DigitalMenu.Onboarding
