# SSR frontend image (docs/20-DEPLOY-AZURE.md). Serves the Angular app and
# proxies /api to the API over PUBLIC_API_ORIGIN (one-origin topology).
FROM node:24-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:24-alpine
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /src/dist ./dist
ENV PORT=8080 \
    NODE_ENV=production
EXPOSE 8080
CMD ["node", "dist/digital-menu/server/server.mjs"]
