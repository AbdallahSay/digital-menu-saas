    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
