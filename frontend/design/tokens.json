{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Digital Menu SaaS Design Tokens",
  "version": "1.0.0",
  "description": "Mobile-first, Arabic-first design tokens for customer menu, owner admin, and platform admin.",
  "tokens": {
    "color": {
      "brand": {
        "primary": { "value": "#0F766E", "description": "Default emerald teal brand color" },
        "primaryHover": { "value": "#0D655E", "description": "Hover state for brand actions" },
        "primaryActive": { "value": "#0A4E49", "description": "Pressed state" },
        "primaryContainer": { "value": "#CCFBF1", "description": "Subtle tint container background" },
        "onPrimary": { "value": "#FFFFFF", "description": "Text on primary color" },
        "onPrimaryContainer": { "value": "#115E59", "description": "Text on container background" }
      },
      "neutral": {
        "background": { "value": "#F8FAFC", "description": "App background canvas" },
        "surface": { "value": "#FFFFFF", "description": "Card and sheet surface" },
        "surfaceMuted": { "value": "#F1F5F9", "description": "Muted container and chip background" },
        "surfaceSubtle": { "value": "#F8FAFC", "description": "Subtle zebra striping or secondary container" },
        "border": { "value": "#E2E8F0", "description": "Standard dividing line and card border" },
        "borderStrong": { "value": "#CBD5E1", "description": "Emphasized border and input stroke" }
      },
      "text": {
        "primary": { "value": "#0F172A", "description": "High contrast body text (WCAG AAA 16.2:1)" },
        "secondary": { "value": "#475569", "description": "Medium contrast descriptions (WCAG AA 5.9:1)" },
        "muted": { "value": "#64748B", "description": "De-emphasized labels (WCAG AA 4.6:1)" },
        "inverse": { "value": "#FFFFFF", "description": "Text on dark background" },
        "disabled": { "value": "#94A3B8", "description": "Disabled label text" }
      },
      "semantic": {
        "success": { "value": "#15803D", "description": "Success indicators and published badges" },
        "successBackground": { "value": "#DCFCE7", "description": "Success container" },
        "warning": { "value": "#B45309", "description": "Warning badges and offline alerts" },
        "warningBackground": { "value": "#FEF3C7", "description": "Warning container" },
        "danger": { "value": "#B91C1C", "description": "Destructive actions and error states" },
        "dangerBackground": { "value": "#FEE2E2", "description": "Danger container" },
        "soldOut": { "value": "#64748B", "description": "Out of stock / unavailable items" },
        "soldOutBackground": { "value": "#F1F5F9", "description": "Unavailable item card pill" }
      }
    },
    "typography": {
      "fontFamily": {
        "arabic": { "value": "'Tajawal', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
        "latin": { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
        "mono": { "value": "'JetBrains Mono', 'SF Mono', monospace" }
      },
      "fontSize": {
        "xs": { "value": "0.75rem", "pixels": "12px", "lineHeight": "1.5" },
        "sm": { "value": "0.875rem", "pixels": "14px", "lineHeight": "1.5" },
        "base": { "value": "1rem", "pixels": "16px", "lineHeight": "1.6" },
        "lg": { "value": "1.125rem", "pixels": "18px", "lineHeight": "1.5" },
        "xl": { "value": "1.25rem", "pixels": "20px", "lineHeight": "1.4" },
        "2xl": { "value": "1.5rem", "pixels": "24px", "lineHeight": "1.3" },
        "3xl": { "value": "1.875rem", "pixels": "30px", "lineHeight": "1.25" },
        "4xl": { "value": "2.25rem", "pixels": "36px", "lineHeight": "1.2" }
      },
      "fontWeight": {
        "regular": { "value": "400" },
        "medium": { "value": "500" },
        "semiBold": { "value": "600" },
        "bold": { "value": "700" }
      }
    },
    "spacing": {
      "1": { "value": "0.25rem", "pixels": "4px" },
      "2": { "value": "0.5rem", "pixels": "8px" },
      "3": { "value": "0.75rem", "pixels": "12px" },
      "4": { "value": "1rem", "pixels": "16px" },
      "5": { "value": "1.25rem", "pixels": "20px" },
      "6": { "value": "1.5rem", "pixels": "24px" },
      "8": { "value": "2rem", "pixels": "32px" },
      "10": { "value": "2.5rem", "pixels": "40px" },
      "12": { "value": "3rem", "pixels": "48px" },
      "16": { "value": "4rem", "pixels": "64px" }
    },
    "borderRadius": {
      "none": { "value": "0" },
      "sm": { "value": "0.25rem", "pixels": "4px" },
      "md": { "value": "0.5rem", "pixels": "8px" },
      "lg": { "value": "0.75rem", "pixels": "12px" },
      "xl": { "value": "1rem", "pixels": "16px" },
      "full": { "value": "9999px", "description": "Pills, badges and rounded avatar circles" }
    },
    "shadow": {
      "sm": { "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
      "md": { "value": "0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.04)" },
      "lg": { "value": "0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.03)" },
      "sheet": { "value": "0 -10px 25px -5px rgb(0 0 0 / 0.1), 0 -4px 6px -4px rgb(0 0 0 / 0.04)" },
      "modal": { "value": "0 20px 25px -5px rgb(0 0 0 / 0.15), 0 8px 10px -6px rgb(0 0 0 / 0.08)" }
    },
    "breakpoints": {
      "xs": { "value": "320px", "description": "Ultra-compact mobile guarantee" },
      "sm": { "value": "375px", "description": "Standard mobile viewport" },
      "md": { "value": "768px", "description": "Tablet and large foldable viewport" },
      "lg": { "value": "1024px", "description": "Desktop laptop viewport" },
      "xl": { "value": "1280px", "description": "High-resolution desktop monitor" }
    },
    "zIndex": {
      "base": { "value": "0" },
      "sticky": { "value": "100", "description": "Sticky category bar and header" },
      "dropdown": { "value": "200", "description": "Language and filter popovers" },
      "backdrop": { "value": "300", "description": "Modal and bottom sheet scrim" },
      "modal": { "value": "400", "description": "Dialog and drawer sheets" },
      "toast": { "value": "500", "description": "Floating feedback alerts" }
    },
    "touchTarget": {
      "min": { "value": "44px", "description": "WCAG 2.2 Level AA target size" },
      "preferred": { "value": "48px", "description": "Mobile touch target ergonomics" }
    }
  }
}
